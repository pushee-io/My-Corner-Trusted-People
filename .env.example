# App
APP_NAME=My Corner
APP_ENV=development
APP_LOCALE=en-GH
APP_TIMEZONE=Africa/Accra
APP_CURRENCY=GHS
FEATURE_AI_SERVICE_REQUEST_STRUCTURER=false
FEATURE_AI_CONTENT_MODERATION=false

# Events remains fail-closed unless both the client and database flags are enabled.
EXPO_PUBLIC_FEATURE_EVENTS=disabled
# Use `seeded` only for explicit local development; production always uses Supabase.
EXPO_PUBLIC_EVENTS_REPOSITORY=supabase
EXPO_PUBLIC_EVENTS_ALLOW_SEEDED_DEVELOPMENT=false

# Mobile active location preview
EXPO_PUBLIC_MY_CORNER_ACTIVE_NEIGHBORHOOD_ID=east-legon
EXPO_PUBLIC_MY_CORNER_ACTIVE_AREA_LABEL=East Legon · Accra
EXPO_PUBLIC_MY_CORNER_ACTIVE_CLUSTER_ID=accra-east
EXPO_PUBLIC_MY_CORNER_ACTIVE_REGION_ID=greater-accra
EXPO_PUBLIC_MY_CORNER_ACTIVE_REGION_NAME=Greater Accra

# Backend
SUPABASE_URL=your-supabase-url
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-side-only

# AI
OPENAI_DEEP_MODEL=
OPENAI_DEFAULT_MODEL=
OPENAI_FAST_MODEL=
OPENAI_IMAGE_MODEL=
OPENAI_MODERATION_MODEL=
OPENAI_EMBEDDING_MODEL=
OPENAI_API_KEY=server-side-only

# Monitoring
SENTRY_DSN=
