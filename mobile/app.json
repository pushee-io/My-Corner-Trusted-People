{
  "expo": {
    "name": "My Corner",
    "slug": "my-corner",
    "scheme": "mycorner",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E6B50"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E6B50"
      },
      "package": "com.mycorner.trustedpeople"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow My Corner to use the photos and videos you choose.",
          "cameraPermission": "Allow My Corner to take a photo or record a video.",
          "microphonePermission": "Allow My Corner to record audio with your videos."
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "useMockData": true,
      "locale": "en-GH",
      "currency": "GHS",
      "timezone": "Africa/Accra",
      "router": {},
      "eas": {
        "projectId": "cff4c187-09a6-4f09-9ddd-a7b04a8eccae"
      }
    },
    "owner": "mycorner"
  }
}
